{
  "openapi": "3.1.0",
  "info": {
    "title": "MongoDB Atlas Administration API",
    "version": "2.0",
    "license": {
      "name": "CC BY-NC-SA 3.0 US",
      "url": "https://creativecommons.org/licenses/by-nc-sa/3.0/us/"
    }
  },
  "servers": [
    {
      "url": "https://cloud.mongodb.com"
    }
  ],
  "tags": [
    {
      "name": "GadgetView"
    }
  ],
  "paths": {
    "/api/atlas/v2/groups/{groupId}/gadgets": {
      "get": {
        "tags": [
          "GadgetView"
        ],
        "summary": "Return GadgetView",
        "operationId": "listGadgets",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/vnd.atlas.2023-01-01+json": {
                "schema": {
                  "$ref": "#/components/schemas/GadgetView"
                },
                "x-xgen-version": "2023-01-01"
              }
            }
          }
        },
        "security": [
          {
            "DigestAuth": []
          }
        ],
        "x-xgen-owner-team": "Cloud"
      }
    }
  },
  "components": {
    "securitySchemes": {
      "DigestAuth": {
        "type": "http",
        "scheme": "digest"
      }
    },
    "schemas": {
      "GadgetView": {
        "type": "object",
        "properties": {
          "count": {
            "type": [
              "integer",
              "null"
            ],
            "exclusiveMinimum": 0,
            "exclusiveMaximum": 100,
            "description": "Positive count."
          },
          "status": {
            "type": "string",
            "enum": [
              "OPEN",
              "CLOSED"
            ],
            "examples": [
              "OPEN",
              "CLOSED"
            ]
          },
          "owner": {
            "$ref": "#/components/schemas/GadgetOwnerView",
            "description": "Owner, described next to the reference.",
            "readOnly": true
          }
        }
      },
      "GadgetOwnerView": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "examples": [
              "Ada"
            ]
          }
        }
      }
    }
  }
}